# LLM / OpenAI-compatible service
# 推荐使用 LLM_* 命名；OPENAI_* 仍然兼容（作为 fallback）。
# 如果同时设置，优先读取 LLM_*。
LLM_API_KEY=
LLM_BASE_URL=https://your-provider.example/v1
LLM_MODEL=
# 如果视觉模型和文本模型不同，可单独配置；留空则回退到 LLM_MODEL
LLM_VISION_MODEL=
# chat：普通 Chat Completions；responses：Responses API（Web Search 必需）
LLM_API_MODE=chat
# 流式接收模型输出（默认开启）。报告写作动辄一两百秒，很多中转/反代（尤其是
# Cloudflare 前置的）会掐掉约 120 秒内没有任何字节的连接，非流式请求在模型生成
# 完成前一个字节都不发，因此会直接报连接错误——限制输出长度也救不了，模型思考
# 期间同样是静默的。只有在你的服务商 SSE 实现有问题时才设为 false。
LLM_STREAM=true
ENABLE_WEB_SEARCH=false

# 项目日志级别（DEBUG/INFO/WARNING/ERROR）。公共模式下异常只记录在服务器端，
# 排查问题时调成 DEBUG。第三方库（LiteLLM 等）始终保持 WARNING。
LOG_LEVEL=INFO

# Deployment safety
# public（默认）：不向页面下发服务器 Key，只允许 HTTPS 公网 API，禁用全局缓存清理
# local：适合本机单用户开发，允许 http://localhost / Ollama 等私网接口
APP_DEPLOYMENT_MODE=public
# CrewAI 的 verbose 日志和任务回放数据库可能包含提示词、输入与完整输出。
# public 模式默认都关闭，local 模式默认都开启；仅在明确接受数据暴露/落盘时取消
# 注释并设置 true/false 来覆盖部署模式默认值。
# CREWAI_VERBOSE=false
# CREWAI_PERSIST_TASK_OUTPUTS=false
# 公共部署的自定义兼容商必须加入此白名单，逗号分隔；支持 *.example.com
# 留空时只允许页面内置服务商域名
APP_ALLOWED_API_HOSTS=
# 仅在明确需要访问私网兼容服务时启用；公共部署还必须把对应主机加入上方白名单
APP_ALLOW_PRIVATE_API_HOSTS=false
# 如需迁移全部可写数据，请在启动 Python 前通过系统/容器环境设置 AUTO_REPORT_HOME；
# 它不能写在本文件中，因为程序必须先知道目录才能定位要读取的 .env。

# 兼容旧命名（可选，与 LLM_* 任选其一）
# OPENAI_API_KEY=
# OPENAI_API_BASE=https://your-provider.example/v1
# OPENAI_MODEL_NAME=
# OPENAI_VISION_MODEL_NAME=
# OPENAI_API_MODE=chat

# Literature staged-reading options
PAPER_CACHE_ENABLED=true
PAPER_FALLBACK_ON_MERGE_TIMEOUT=true
PAPER_CHUNK_SIZE=6000
PAPER_MAX_CHUNKS_PER_DOC=10
PAPER_MAX_CHARS_PER_DOC=120000
PAPER_STAGE_TIMEOUT=90
PAPER_STAGE_RETRIES=1
# 同一篇文献内同时分析的片段数。调大能明显缩短长文献的等待时间，但会并发向
# 兼容商发起多个请求，更容易触发 429 限流；免费或低配额账号建议设为 1-2。
PAPER_STAGE_CONCURRENCY=4
PAPER_STAGE_MAX_OUTPUT_TOKENS=900
PAPER_STAGE_MERGE_TOKENS=1400
# 分阶段上下文字符预算（token 的近似上限；中文常接近 1-2 字符/token，英文约 3-4）。
# 程序另有不可调高的硬上限。
# 每层会公平保留所有片段/文献及其首尾；模型异常冗长或合并降级也不会无限拼接。
PAPER_STAGE_METADATA_CHARS=1200
PAPER_STAGE_CHUNK_PROMPT_CHARS=16000
PAPER_STAGE_CHUNK_SUMMARY_CHARS=3600
PAPER_STAGE_DOC_PROMPT_CHARS=32000
PAPER_STAGE_DOC_SUMMARY_CHARS=5600
PAPER_STAGE_CORPUS_PROMPT_CHARS=48000
PAPER_STAGE_CORPUS_SUMMARY_CHARS=8400
PAPER_STAGE_FALLBACK_CHARS=40000
PAPER_CONTEXT_MAX_CHARS=60000

# Final CrewAI paper-writing mode:
# fast = use staged literature summary directly, fewer/slimmer LLM calls
# full = run paper_analysis -> paper_writing -> paper_review
PAPER_CREW_MODE=fast
# 最终审核失败时保留可用文献产物；优先保留非空审核稿，否则恢复写作草稿。
PAPER_KEEP_DRAFT_ON_FAILURE=true

# Upload/resource limits
MAX_IMAGE_MB=10
MAX_DOCUMENTS=5
MAX_DOCUMENT_FILE_MB=25
MAX_DOCUMENT_TOTAL_MB=50
MAX_PDF_PAGES=200
MAX_DOCX_UNCOMPRESSED_MB=100

# Sidebar cache monitor threshold. This is only a warning quota; cleanup is manual.
CACHE_QUOTA_MB=500

# 自动保留期（天）：周期性删除超过该天数的运行目录（output/runs/<run_id>）和文献
# 缓存命名空间。被删缓存会在下次请求时重新生成；0 关闭这两类目录的自动清理。
# 当 CrewAI 任务持久化被禁用时，历史共享回放数据库仍会被清除，不受 0 影响。
OUTPUT_RETENTION_DAYS=7
# 同一进程两次自动清理之间的最短秒数（默认每小时；允许范围 1 秒到 7 天）。
OUTPUT_RETENTION_SWEEP_INTERVAL_SECONDS=3600
